# Compose reads the first two variables from the root .env file.
# Local Uvicorn reads values from the shell environment.
TRACELENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRACELENS_MAX_UPLOAD_BYTES=26214400
# Compose sets its own path inside the persistent volume.
TRACELENS_DB_PATH=./tracelens.sqlite3

